{
  "name": "BuildLog",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "session_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "default": "success"
    },
    "stage": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "version": {
      "type": "number"
    },
    "duration_ms": {
      "type": "number"
    }
  },
  "required": [
    "project_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}